//@version=5
//By Sorachai
indicator("Gold OI Block SD", overlay=true, max_lines_count=200 ,max_labels_count=300)

// --- 1. Configuration (การตั้งค่า) ---
group_calc = "Diff Calculation"
group_grid = "Grid Settings"

// Input ราคาเพื่อหา Diff
price1_input = input.float(4207.0, title="XAUUSD (CFD)", group=group_calc, tooltip="ํYour CFD Price")
price2_input = input.float(4237.0, title="GC1! (Futures)", group=group_calc, tooltip="Investing.com GC Futures Price")
// หรือกรอกค่า Diff ตรงๆ แทนการกรอกราคาสองตัว
use_direct_diff = input.bool(false, title="Use Direct Diff", group=group_calc, tooltip="เปิดเพื่อกรอกค่า Diff ตรงๆ (Futures - CFD) แทนการกรอกราคา Spot/Futures ด้านบน")
direct_diff_input = input.float(30.0, title="Diff (Futures - CFD)", group=group_calc, tooltip="ใช้เมื่อเปิด Use Direct Diff เช่น Futures 4237, Spot 4207 -> Diff = 30 (ปกติ Futures สูงกว่า ใส่เลขบวกได้เลย)")

// Futures Daily Open สำหรับปัดเศษ Grid (อ้างอิงราคาเปิด Future จริง ไม่ใช่ราคาเปิดของกราฟที่รันอยู่)
use_auto_futures_open = input.bool(true, title="Auto-fetch Futures Daily Open", group=group_calc, tooltip="ดึงราคาเปิดจาก Futures Symbol ด้านล่างอัตโนมัติ ปิดถ้าอยากกรอกเอง")
futures_symbol_input = input.symbol("COMEX:GC1!", title="Futures Symbol", group=group_calc, tooltip="ปรับได้ถ้า Symbol นี้ไม่ตรงกับที่ TDW รองรับ")
manual_futures_open_input = input.float(4237.0, title="Manual Futures Daily Open", group=group_calc, tooltip="ใช้เมื่อปิด Auto-fetch")

// ตั้งค่า Mean Reversion SD (mean = ราคาเปิด Futures, ค่าทั้งหมดเป็นสเกล Futures)
group_sd = "Mean Reversion SD"
show_sd = input.bool(true, title="Show SD Lines", group=group_sd)
sd_mode = input.string("Range", title="SD Input Mode", options=["Range", "Paste Levels"], group=group_sd, tooltip="Range = กรอกระยะ 1SD/2SD/3SD จากราคาเปิด Futures | Paste Levels = วางราคา Futures ของทั้ง 6 เส้นตรงๆ")
sd1_range = input.float(0.0, title="1SD Range", minval=0.0, group=group_sd, tooltip="ระยะจากราคาเปิด Futures (0 = ไม่วาด)")
sd2_range = input.float(0.0, title="2SD Range (0 = 1SD x2)", minval=0.0, group=group_sd, tooltip="เว้น 0 เพื่อให้คูณ 2 จาก 1SD อัตโนมัติ หรือกรอกเองเพื่อ override")
sd3_range = input.float(0.0, title="3SD Range (0 = 1SD x3)", minval=0.0, group=group_sd, tooltip="เว้น 0 เพื่อให้คูณ 3 จาก 1SD อัตโนมัติ หรือกรอกเองเพื่อ override")
sd_paste = input.string("", title="Paste SD Levels (Futures)", group=group_sd, tooltip="วางราคา Futures 6 ค่า คั่นด้วย , ตาม format: Buy1SD, Sell1SD, Buy2SD, Sell2SD, Buy3SD, Sell3SD เช่น 3972.8, 4125.6, 3896.3, 4202.1, 3819.9, 4278.5")
// สี SD ไล่เฉดตามระดับ: 1SD อ่อน -> 3SD เข้ม
sd_buy1_color = input.color(color.rgb(165, 214, 167), title="1SD Buy", inline="sd1", group=group_sd)
sd_sell1_color = input.color(color.rgb(239, 154, 154), title=" Sell", inline="sd1", group=group_sd)
sd_buy2_color = input.color(color.rgb(67, 160, 71), title="2SD Buy", inline="sd2", group=group_sd)
sd_sell2_color = input.color(color.rgb(229, 57, 53), title=" Sell", inline="sd2", group=group_sd)
sd_buy3_color = input.color(color.rgb(27, 94, 32), title="3SD Buy", inline="sd3", group=group_sd)
sd_sell3_color = input.color(color.rgb(139, 0, 0), title=" Sell", inline="sd3", group=group_sd)
sd_line_width = input.int(1, title="SD Line Width", minval=1, group=group_sd)
show_sd_on_scale = input.bool(true, title="Show SD on Price Scale", group=group_sd, tooltip="แสดงระดับ SD เป็นป้ายบนแถบราคาขวามือ (ตัวเลขเป็นราคา Spot ตามแกน)")

// ตั้งค่า Grid
oi_block_size = input.int(25, title="OI Block Size", minval=1, group=group_grid)
// จำนวนเส้นต่อฝั่ง (เช่นใส่ 3 จะได้ -3, -2, -1, 0, 1, 2, 3 รวม 7 เส้น)
line_count = input.int(3, title="Number of Lines (Per Side)", minval=2,maxval=30, group=group_grid)
mini_block = input.int(0,title="Mini Block", minval=0,step=5,group=group_grid)
show_recovery = input.bool(false, title="Show Recovery", group=group_grid)

// ตั้งค่าเส้นราคาเปิด Future และเส้น Breakout %
group_open = "Futures Open Levels"
show_open_line = input.bool(true, title="Show Futures Open Line", group=group_open)
breakout_pct = input.float(0.5, title="Breakout %", minval=0.0, step=0.1, group=group_open, tooltip="ถ้าราคาทะลุราคาเปิดไปเกิน % นี้ ราคาทั้งวันมักไปทางนั้น (ใส่ 0 เพื่อปิดเส้น %)")
open_line_color = input.color(color.orange, title="Open Line Color", group=group_open)
open_line_width = input.int(2, title="Open Line Width", minval=1, group=group_open)
breakout_line_color = input.color(color.purple, title="Breakout Line Color", group=group_open)
breakout_line_width = input.int(1, title="Breakout Line Width", minval=1, group=group_open)
// Style
line_color = input.color(color.blue, title="OI Block Color", group="Style")
line_width = input.int(1, title="OI Block Width", minval=1, group="Style")
mini_line_color = input.color(color.rgb(168, 216, 255), title="Mini Block Color", group="Style")
mini_line_width = input.int(1, title="Mini Block Width", minval=1, group="Style")
recover_line_color = input.color(color.rgb(250, 164, 164), title="Recovery Block Color", group="Style")
recover_line_width = input.int(1, title="Recovery Block Width", minval=1, group="Style")
show_labels = input.bool(true, title="Show Futures Price", group="Style")

// --- 2. Calculation ---

// 2.1 หา Delta Diff (ภายในเก็บเป็น CFD - Futures เสมอ / ช่องกรอกตรงเป็น Futures - CFD เลยกลับเครื่องหมาย)
delta_diff = use_direct_diff ? -direct_diff_input : price1_input - price2_input

// 2.2 หา Daily Open ของ Futures (อ้างอิงราคาเปิด Future จริง ไม่ใช่ราคาเปิดของกราฟที่รันอยู่)
futures_daily_open = use_auto_futures_open ? request.security(futures_symbol_input, "D", open, lookahead=barmerge.lookahead_on) : manual_futures_open_input

yesterday_close = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
//log.info(str.tostring(yesterday_close))


// 2.3 หาจุด Center หลัก (ปัดเศษราคาเปิด Futures ให้ลงล็อกก่อน ค่อยแปลงเป็น Spot ทีหลังผ่าน delta_diff)
base_center = math.round(futures_daily_open / oi_block_size) * oi_block_size

// 2.4 หา Zone OI ที่ราคาปัจจุบันวิ่งอยู่ (แปลงราคาปัจจุบันเป็นสเกล Futures ก่อน แล้วหา block บน/ล่างที่ครอบอยู่)
show_zone_on_scale = input.bool(true, title="Show Active Zone on Price Scale", group=group_grid, tooltip="แสดงขอบบน/ล่างของ Zone ที่ราคากำลังวิ่งอยู่ บนแถบราคาขวามือ พร้อมตารางราคา Futures ติดขอบขวากลางจอ")
show_zone_spot_price = input.bool(true, title="Show Zone Spot Price on Scale", group=group_grid, tooltip="แสดงราคา Spot ของขอบ Zone เป็นป้ายบนแถบราคาขวามือ")
futures_price_now = close - delta_diff
active_zone_lower_f = math.floor(futures_price_now / oi_block_size) * oi_block_size
active_zone_upper_f = active_zone_lower_f + oi_block_size
active_zone_lower = active_zone_lower_f + delta_diff
active_zone_upper = active_zone_upper_f + delta_diff

// plot ราคา Spot ของขอบ Zone เฉพาะบนแถบราคาขวามือ (ไม่วาดเส้นบนกราฟ)
plot(show_zone_spot_price ? active_zone_upper : na, title="OI Zone Upper (Spot)", color=line_color, display=display.price_scale)
plot(show_zone_spot_price ? active_zone_lower : na, title="OI Zone Lower (Spot)", color=line_color, display=display.price_scale)

// 2.5 คำนวณระดับ SD ทั้ง 6 เส้น (สเกล Futures) - อยู่ global scope เพื่อใช้ทำป้ายบนแกนราคา
// Paste mode: parse ครั้งเดียวตอนแท่งแรก (input คงที่ตลอด)
var float paste_b1 = na
var float paste_s1 = na
var float paste_b2 = na
var float paste_s2 = na
var float paste_b3 = na
var float paste_s3 = na
if barstate.isfirst and show_sd and sd_mode == "Paste Levels"
    parts = str.split(str.replace_all(sd_paste, " ", ""), ",")
    if array.size(parts) == 6
        b1 = str.tonumber(array.get(parts, 0))
        s1 = str.tonumber(array.get(parts, 1))
        b2 = str.tonumber(array.get(parts, 2))
        s2 = str.tonumber(array.get(parts, 3))
        b3 = str.tonumber(array.get(parts, 4))
        s3 = str.tonumber(array.get(parts, 5))
        // parse ไม่ครบ 6 ค่า = ไม่วาดเลย กัน plot มั่ว
        if not (na(b1) or na(s1) or na(b2) or na(s2) or na(b3) or na(s3))
            paste_b1 := b1
            paste_s1 := s1
            paste_b2 := b2
            paste_s2 := s2
            paste_b3 := b3
            paste_s3 := s3

// Range mode: 2SD/3SD เว้น 0 = คูณ 2/3 จาก 1SD อัตโนมัติ
sd2_eff = sd2_range > 0 ? sd2_range : sd1_range * 2
sd3_eff = sd3_range > 0 ? sd3_range : sd1_range * 3
sd_paste_ok = show_sd and sd_mode == "Paste Levels" and not na(paste_b1)
sd_range_ok = show_sd and sd_mode == "Range" and sd1_range > 0

sd_buy1_f  = sd_paste_ok ? paste_b1 : sd_range_ok ? futures_daily_open - sd1_range : float(na)
sd_sell1_f = sd_paste_ok ? paste_s1 : sd_range_ok ? futures_daily_open + sd1_range : float(na)
sd_buy2_f  = sd_paste_ok ? paste_b2 : sd_range_ok ? futures_daily_open - sd2_eff : float(na)
sd_sell2_f = sd_paste_ok ? paste_s2 : sd_range_ok ? futures_daily_open + sd2_eff : float(na)
sd_buy3_f  = sd_paste_ok ? paste_b3 : sd_range_ok ? futures_daily_open - sd3_eff : float(na)
sd_sell3_f = sd_paste_ok ? paste_s3 : sd_range_ok ? futures_daily_open + sd3_eff : float(na)

// ป้าย SD บนแถบราคาขวามือ (ไม่วาดเส้นบนกราฟ ตำแหน่ง/ตัวเลขเป็นราคา Spot ตามแกน)
plot(show_sd_on_scale ? sd_buy1_f + delta_diff : na, title="Buy 1SD (Spot)", color=sd_buy1_color, display=display.price_scale)
plot(show_sd_on_scale ? sd_sell1_f + delta_diff : na, title="Sell 1SD (Spot)", color=sd_sell1_color, display=display.price_scale)
plot(show_sd_on_scale ? sd_buy2_f + delta_diff : na, title="Buy 2SD (Spot)", color=sd_buy2_color, display=display.price_scale)
plot(show_sd_on_scale ? sd_sell2_f + delta_diff : na, title="Sell 2SD (Spot)", color=sd_sell2_color, display=display.price_scale)
plot(show_sd_on_scale ? sd_buy3_f + delta_diff : na, title="Buy 3SD (Spot)", color=sd_buy3_color, display=display.price_scale)
plot(show_sd_on_scale ? sd_sell3_f + delta_diff : na, title="Sell 3SD (Spot)", color=sd_sell3_color, display=display.price_scale)

// --- 3. Drawing Logic ---

var line[] lines_arr = array.new_line()
var label[] labels_arr = array.new_label()
//var label close_label = label.new(na, na, style=label.style_label_right, color=color.blue, textcolor=color.white)

// --- 4. Watermark Section (ส่วนลายน้ำ) ---
// Input สำหรับตั้งค่าข้อความ
show_wm = input.bool(true, title="Show Futures - CFD Price", group="Delta Watermark")
//wm_text  = input.string("OI Block System", title="Watermark Text", group="Delta Watermark")
wm_size  = input.string(size.huge, title="Watermark Size", options=[size.small, size.normal, size.large, size.huge], group="Delta Watermark")
wm_color = input.color(color.new(color.gray, 70), title="Watermark Color", group="Delta Watermark")
wm_pos   = input.string(position.top_center, title="Position", options=[position.bottom_right, position.top_right, position.bottom_left, position.top_left, position.bottom_center, position.top_center], group="Delta Watermark")

// สร้างตารางเพื่อแสดงผล
// ใช้ var เพื่อสร้างตัวแปร table แค่ครั้งเดียว
var table wm_table = table.new(wm_pos, 1, 1)

// ฟังก์ชันวาดเส้น
draw_level(idx) =>
    // คำนวณระดับราคา Raw (Base + (Index * BlockSize))
    // Index จะวิ่งตั้งแต่ -3 ถึง +3 ทำให้ครอบคลุมเส้นกลาง (0) ด้วย
    raw_level = base_center + (idx * oi_block_size)
    
    // บวก Diff เข้าไปเพื่อหาจุดตีเส้นจริง
    plot_level = raw_level + delta_diff
    
    // เวลา: เริ่มต้นวัน -> จบวัน (24 ชม.)
    start_time = time("D")
    end_time = start_time + 86400000 
    
    // สร้างเส้น
    l = line.new(x1=start_time, y1=plot_level, x2=end_time, y2=plot_level, xloc=xloc.bar_time, color=line_color, width=line_width)
    array.push(lines_arr, l)
    //build mini block
    if mini_block > 0
        l1 = line.new(x1=start_time, y1=plot_level+mini_block, x2=end_time, y2=plot_level+mini_block, xloc=xloc.bar_time, color=mini_line_color, width=mini_line_width, style = line.style_dashed)
        array.push(lines_arr, l1)
        l2 = line.new(x1=start_time, y1=plot_level+(2*mini_block), x2=end_time, y2=plot_level+(2*mini_block), xloc=xloc.bar_time, color=mini_line_color, width=mini_line_width, style = line.style_dashed)
        array.push(lines_arr, l2)
        l3 = line.new(x1=start_time, y1=plot_level-mini_block, x2=end_time, y2=plot_level-mini_block, xloc=xloc.bar_time, color=mini_line_color, width=mini_line_width, style = line.style_dashed)
        array.push(lines_arr, l3)
        l4 = line.new(x1=start_time, y1=plot_level-(2*mini_block), x2=end_time, y2=plot_level-(2*mini_block), xloc=xloc.bar_time, color=mini_line_color, width=mini_line_width, style = line.style_dashed)
        array.push(lines_arr, l4)

    if show_recovery
        if idx > 0
            recovery_line = line.new(x1=start_time, y1=plot_level-(oi_block_size/2), x2=end_time, y2=plot_level-(oi_block_size/2), xloc=xloc.bar_time, color=recover_line_color, width=recover_line_width, style = line.style_dotted)
            array.push(lines_arr, recovery_line)
        if idx < 0
            recovery_line = line.new(x1=start_time, y1=plot_level+(oi_block_size/2), x2=end_time, y2=plot_level+(oi_block_size/2), xloc=xloc.bar_time, color=recover_line_color, width=recover_line_width, style = line.style_dotted)
            array.push(lines_arr, recovery_line)
    
    // สร้าง Label
    if show_labels
        txt = str.tostring(raw_level, "#")
        //lb_close_yesterday = label.new( x=start_time , y=yesterday_close ,text="OI VolSat : "+ str.tostring(yesterday_close + (price2_input - price1_input)),  xloc=xloc.bar_time,style=label.style_label_right, color=color.blue, textcolor=color.white)
        //array.push(labels_arr,lb_close_yesterday)
        lb_end = label.new(x=end_time, y=plot_level, text=txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.white, 100), textcolor=line_color, size=size.normal)
        array.push(labels_arr,lb_end)
        lb_start = label.new(x=start_time, y=plot_level, text=txt, xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 100), textcolor=line_color, size=size.normal)
        array.push(labels_arr,lb_start)
        //lbm = label.new(x=(start_time + end_time) /2, y=plot_level+1, text=txt, xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
        if mini_block > 0
            //l1_label = label.new(x=((start_time + end_time)/2), y=plot_level+mini_block, text=str.tostring(raw_level+mini_block, "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            l1_label_1 = label.new(x=((start_time + end_time)/2) - ((end_time - start_time)/4), y=plot_level+mini_block, text=str.tostring(raw_level+mini_block, "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            array.push(labels_arr,l1_label_1)
            l1_label_2 = label.new(x=((start_time + end_time)/2) + ((end_time - start_time)/4), y=plot_level+mini_block, text=str.tostring(raw_level+mini_block, "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            array.push(labels_arr,l1_label_2)
            l2_label = label.new(x=((start_time + end_time)/2), y=plot_level+(2*mini_block), text=str.tostring(raw_level+(2*mini_block), "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            array.push(labels_arr,l2_label)
            //l3_label = label.new(x=((start_time + end_time)/2), y=plot_level-mini_block, text=str.tostring(raw_level-mini_block, "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            l3_label_1 = label.new(x=((start_time + end_time)/2) - ((end_time - start_time)/4), y=plot_level-mini_block, text=str.tostring(raw_level-mini_block, "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            array.push(labels_arr,l3_label_1)
            l3_label_2 = label.new(x=((start_time + end_time)/2) + ((end_time - start_time)/4), y=plot_level-mini_block, text=str.tostring(raw_level-mini_block, "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            array.push(labels_arr,l3_label_2)
            l4_label = label.new(x=((start_time + end_time)/2), y=plot_level-(2*mini_block), text=str.tostring(raw_level-(2*mini_block), "#"), xloc=xloc.bar_time, style=label.style_label_center, color=color.new(color.white, 100), textcolor=line_color, size=size.small)
            array.push(labels_arr,l4_label)


// ฟังก์ชันวาดเส้นราคาเปิด Future และเส้น Breakout ±%
// level_futures = ราคาในสเกล Futures -> บวก delta_diff ก่อน plot ลง Spot เสมอ
draw_open_level(level_futures, lvl_color, lvl_width, lvl_style, txt_prefix, show_lb) =>
    plot_level = level_futures + delta_diff
    start_time = time("D")
    end_time = start_time + 86400000
    l = line.new(x1=start_time, y1=plot_level, x2=end_time, y2=plot_level, xloc=xloc.bar_time, color=lvl_color, width=lvl_width, style=lvl_style)
    array.push(lines_arr, l)
    if show_labels and show_lb
        txt = txt_prefix + str.tostring(level_futures, "#.#")
        lb = label.new(x=start_time, y=plot_level, text=txt, xloc=xloc.bar_time, style=label.style_label_right, color=color.new(color.white, 100), textcolor=lvl_color, size=size.normal)
        array.push(labels_arr, lb)

// ฟังก์ชันวาดชื่อเส้น SD เป็น text ธรรมดาบนเส้น ติดขวาแท่งล่าสุด (วิ่งตามราคา)
// Sell = text ลอยเหนือเส้น / Buy = text ห้อยใต้เส้น จะได้ไม่ทับเส้นตัวเอง
draw_sd_tag(x_pos, level_futures, tag_color, txt, is_sell) =>
    lb_style = is_sell ? label.style_label_down : label.style_label_up
    lb = label.new(x=x_pos, y=level_futures + delta_diff, text=txt, xloc=xloc.bar_time, style=lb_style, color=color.new(color.white, 100), textcolor=tag_color, size=size.small)
    array.push(labels_arr, lb)

// ทำงานเฉพาะแท่งล่าสุด
if barstate.islast
    // ลบของเก่าทิ้ง
    if array.size(lines_arr) > 0
        for i = 0 to array.size(lines_arr) - 1
            line.delete(array.get(lines_arr, i))
    if array.size(labels_arr) > 0
        for i = 0 to array.size(labels_arr) - 1
            label.delete(array.get(labels_arr, i))
    
    array.clear(lines_arr)
    array.clear(labels_arr)

    // set position ใหม่กรณีมีการเปลี่ยน input
    if show_wm
        table.set_position(wm_table, wm_pos) 
        // ใส่ข้อความลงในตาราง
        table.cell(wm_table, column=0, row=0, text="Futures - CFD = " + str.tostring(-delta_diff), text_color=wm_color, text_size=wm_size)

    // ขยายจำนวนเส้น grid อัตโนมัติให้คลุมถึงเส้น SD นอกสุด
    upper_count = line_count
    lower_count = line_count - 1
    if not na(sd_buy1_f)
        sd_max = math.max(sd_buy1_f, sd_sell1_f, sd_buy2_f, sd_sell2_f, sd_buy3_f, sd_sell3_f)
        sd_min = math.min(sd_buy1_f, sd_sell1_f, sd_buy2_f, sd_sell2_f, sd_buy3_f, sd_sell3_f)
        needed_up = math.ceil((sd_max - base_center) / oi_block_size)
        needed_dn = math.ceil((base_center - sd_min) / oi_block_size)
        upper_count := math.max(upper_count, needed_up)
        lower_count := math.max(lower_count, needed_dn)

    // วนลูปสร้างเส้นตั้งแต่ -lower_count ถึง +upper_count
    // เช่น ถ้า line_count = 3 และไม่มี SD จะวน: -2, -1, 0, 1, 2, 3
    for i = -lower_count to upper_count
        //log.info(str.tostring(i))
        draw_level(i)

    // Label ราคา Futures ของ Zone ที่ราคากำลังวิ่งอยู่ ติดขวาแท่งล่าสุด (วิ่งตามราคา ไม่ต้องลากหา)
    if show_zone_on_scale
        // ขยับป้ายไปขวา 4 แท่ง จะได้ไม่บังแท่งราคาล่าสุด
        zone_label_x = time + 4 * timeframe.in_seconds() * 1000
        zone_up_txt = str.tostring(active_zone_upper_f, "#")
        zone_dn_txt = str.tostring(active_zone_lower_f, "#")
        zone_up_lb = label.new(x=zone_label_x, y=active_zone_upper, text=zone_up_txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(line_color, 20), textcolor=color.white, size=size.small)
        array.push(labels_arr, zone_up_lb)
        zone_dn_lb = label.new(x=zone_label_x, y=active_zone_lower, text=zone_dn_txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(line_color, 20), textcolor=color.white, size=size.small)
        array.push(labels_arr, zone_dn_lb)

    // เส้นราคาเปิด Future + เส้น Breakout ±% (คำนวณ % ในสเกล Futures ก่อน ค่อย diff ลง Spot)
    if show_open_line
        draw_open_level(futures_daily_open, open_line_color, open_line_width, line.style_solid, "Open ", true)
        if breakout_pct > 0
            draw_open_level(futures_daily_open * (1 + breakout_pct / 100), breakout_line_color, breakout_line_width, line.style_dashed, "+" + str.tostring(breakout_pct) + "% ", true)
            draw_open_level(futures_daily_open * (1 - breakout_pct / 100), breakout_line_color, breakout_line_width, line.style_dashed, "-" + str.tostring(breakout_pct) + "% ", true)

    // เส้น Mean Reversion SD (ไล่เฉดอ่อน -> เข้ม, ไม่มี label ลอย ใช้ป้ายบนแกนราคาขวาแทน)
    if not na(sd_buy1_f)
        draw_open_level(sd_buy1_f, sd_buy1_color, sd_line_width, line.style_dashed, "", false)
        draw_open_level(sd_sell1_f, sd_sell1_color, sd_line_width, line.style_dashed, "", false)
        draw_open_level(sd_buy2_f, sd_buy2_color, sd_line_width, line.style_dashed, "", false)
        draw_open_level(sd_sell2_f, sd_sell2_color, sd_line_width, line.style_dashed, "", false)
        draw_open_level(sd_buy3_f, sd_buy3_color, sd_line_width, line.style_dashed, "", false)
        draw_open_level(sd_sell3_f, sd_sell3_color, sd_line_width, line.style_dashed, "", false)

        // Tag ชื่อเส้น SD ติดขวาแท่งล่าสุด วิ่งตามราคาไปเรื่อยๆ
        sd_tag_x = time + 4 * timeframe.in_seconds() * 1000
        draw_sd_tag(sd_tag_x, sd_buy1_f, sd_buy1_color, "Buy 1SD", false)
        draw_sd_tag(sd_tag_x, sd_sell1_f, sd_sell1_color, "Sell 1SD", true)
        draw_sd_tag(sd_tag_x, sd_buy2_f, sd_buy2_color, "Buy 2SD", false)
        draw_sd_tag(sd_tag_x, sd_sell2_f, sd_sell2_color, "Sell 2SD", true)
        draw_sd_tag(sd_tag_x, sd_buy3_f, sd_buy3_color, "Buy 3SD", false)
        draw_sd_tag(sd_tag_x, sd_sell3_f, sd_sell3_color, "Sell 3SD", true)
//@version=6
// ============================================================================
//  DXY Pulse — รูปคลื่นของแรงดอลลาร์ สำหรับไม้สวนที่ zone OI (TF 5 นาที)
//
//  กลยุทธ์ที่ตัวนี้รองรับ (เจ้าของงานอธิบายไว้ 20 ก.ย. 2026):
//    A) ราคาถึง zone OI แล้วเด้งทันที — ย้อนดู DXY จะเห็นว่า "ฉีกแรงมาก่อนแล้วหยุดฉีก"
//       สัญญาณคือ impulse -> ชะลอ -> อาจกลับทิศ  => เพชร ◆ บนกราฟราคา
//    B) ราคาวนอยู่แถว zone แล้ว DXY "เริ่มฉีก" — เข้าฝั่งตรงข้ามกับดอลลาร์
//       (DXY ขึ้น = ทองลง)                        => สามเหลี่ยม ▲▼ บนกราฟราคา
//
//  ทำไมเป็นแถบ ไม่ใช่ตัวเลข: ตัวเลขบอก "ตอนนี้เท่าไร" แต่ไม่บอก "รูปทรงของคลื่น"
//  ซึ่งเป็นสิ่งที่ตาดูจริงๆ — แท่งสูงขึ้นสีสด = กำลังฉีก / เตี้ยลงสีจาง = หยุดฉีก /
//  ข้ามศูนย์เปลี่ยนสี = กลับทิศ
//
//  z = (DXY ตอนนี้ − DXY เมื่อ N แท่งก่อน) ÷ ค่าเบี่ยงเบนปกติของการขยับ N แท่งนั้น
//  ใช้ z ไม่ใช่ % ดิบ เพราะ % ตอนตลาดเงียบกับตอนข่าวออกมีความหมายคนละเรื่อง
//
//  ดอลลาร์ใช้ TVC:DXY เพราะ ICEUS:DX1! ดีเลย์ในบัญชีที่ใช้อยู่
//  ย้ายแผงไปไว้ใต้กราฟราคา ส่วนพื้นหลัง/เครื่องหมายวาดทาบบนกราฟราคาด้วย force_overlay
// ============================================================================
indicator("DXY Pulse", overlay = false, precision = 2)

G1 = "ข้อมูล"
dxySym   = input.symbol("TVC:DXY", "สัญลักษณ์ดอลลาร์", group = G1,
     tooltip = "TVC:DXY เป็นดัชนีคำนวณ ยูโรถ่วงน้ำหนักราว 58% — ข่าวฝั่ง ECB ดันตัวนี้ได้โดยไม่เกี่ยวกับทอง\n" +
               "ICEUS:DX1! เดินตาม tick เร็วกว่า ใช้ได้ถ้าบัญชีมีสิทธิ์เรียลไทม์")
nBars    = input.int(3, "หน้าต่างวัดการฉีก (แท่ง)", minval = 1, group = G1,
     tooltip = "TF 5 นาที: 3 แท่ง = 15 นาที")
lookback = input.int(100, "ช่วงอ้างอิงความปกติ (แท่ง)", minval = 20, group = G1,
     tooltip = "TF 5 นาที: 100 แท่ง ≈ 8 ชั่วโมง")

G2 = "เกณฑ์ของคลื่น"
zSpike     = input.float(2.0, "เริ่มนับว่าฉีก (z)", minval = 0.5, step = 0.1, group = G2)
zExit      = input.float(0.8, "ถือว่าคลื่นจบ (z ต่ำกว่า)", minval = 0.1, step = 0.1, group = G2)
stallFrac  = input.float(0.5, "หยุดฉีกเมื่อ z เหลือกี่เท่าของพีค", minval = 0.1, maxval = 0.95,
     step = 0.05, group = G2)
retraceFrac = input.float(0.382, "หรือ DXY ย้อนกลับกี่ส่วนของระยะที่ฉีกมา", minval = 0.1,
     maxval = 0.9, step = 0.05, group = G2)

G3 = "zone OI"
zoneTxt = input.text_area("", "ระดับ zone (คั่นด้วย , หรือขึ้นบรรทัดใหม่)", group = G3,
     tooltip = "ใส่ระดับราคาที่สนใจ เช่น 4285, 4300, 4325 — alert จะยิงเฉพาะตอนราคาอยู่ใกล้ระดับพวกนี้\n" +
               "เว้นว่าง = ไม่กรองด้วย zone (เตือนทุกครั้งที่เข้าเงื่อนไข)")
zoneTol = input.float(5.0, "นับว่า \"อยู่แถวๆ zone\" เมื่อห่างไม่เกิน", minval = 0.1, step = 0.5,
     group = G3)

G4 = "การแสดงผล"
showBg    = input.bool(true, "ทาพื้นหลังกราฟราคาระหว่างดอลลาร์กำลังฉีก", group = G4)
showMarks = input.bool(true, "เครื่องหมายบนกราฟราคา (▲▼ เริ่มฉีก · ◆ หยุดฉีก)", group = G4)
showTable = input.bool(true, "ตารางตัวเลขมุมจอ", group = G4)
tblPos    = input.string("ขวาบน", "ตำแหน่งตาราง", group = G4,
     options = ["ซ้ายบน", "กลางบน", "ขวาบน", "ซ้ายล่าง", "กลางล่าง", "ขวาล่าง"])
cUp = input.color(color.new(#ff5252, 0), "สีตอน DXY ฉีกขึ้น (ทองเป็นขาลง)", group = G4)
cDn = input.color(color.new(#26c281, 0), "สีตอน DXY ฉีกลง (ทองเป็นขาขึ้น)", group = G4)

// ─────────────────────────── ข้อมูล + z ───────────────────────────
dxy = request.security(dxySym, timeframe.period, close, ignore_invalid_symbol = true)

zOf(series float src, int n, int len) =>
    ch = src - src[n]
    sd = ta.stdev(ch, len)
    na(sd) or sd <= 0 ? float(na) : ch / sd

z  = zOf(dxy, nBars, lookback)
az = na(z) ? 0.0 : math.abs(z)
dir = na(z) ? 0 : z > 0 ? 1 : -1

// ─────────────────────────── คลื่นของดอลลาร์ (state machine) ───────────────────────────
// impDir  : ทิศของคลื่นที่กำลังดำเนินอยู่ (+1 ฉีกขึ้น / -1 ฉีกลง / 0 ไม่มีคลื่น)
// impPeak*: จุดที่แรงสุดของคลื่นนี้ — ใช้วัดว่า "คลายมาแล้วเท่าไร"
var int   impDir     = 0
var float impPeakZ   = na
var int   impPeakBar = na
var float impPeakPx  = na      // ค่า DXY ตอนพีค
var float impStartPx = na      // ค่า DXY ตอนคลื่นเริ่ม (ย้อนไป nBars แท่ง)
var bool  stalled    = false   // ประกาศ "หยุดฉีก" ไปแล้วหรือยัง (กันยิงซ้ำทุกแท่ง)

bool onset = false
if not na(z)
    flip = impDir != 0 and dir != impDir and az >= zSpike
    if impDir != 0 and (az < zExit or flip)
        impDir := 0                                   // คลื่นเดิมจบ
    if impDir == 0 and az >= zSpike
        impDir     := dir                             // คลื่นใหม่เริ่ม
        impPeakZ   := az
        impPeakBar := bar_index
        impPeakPx  := dxy
        impStartPx := dxy[nBars]
        stalled    := false
        onset      := true
    else if impDir != 0 and dir == impDir and az > impPeakZ
        impPeakZ   := az                              // แรงขึ้นกว่าเดิม = ยังไม่พีคจริง
        impPeakBar := bar_index
        impPeakPx  := dxy
        stalled    := false

inImp = impDir != 0
// คลายไปกี่ส่วนของระยะที่ฉีกมา (บวก = ย้อนกลับ)
float retr = inImp and not na(impPeakPx) and not na(impStartPx) and impPeakPx != impStartPx
     ? (impPeakPx - dxy) / (impPeakPx - impStartPx) : na
zFade    = inImp and not na(impPeakZ) and impPeakZ > 0 ? az / impPeakZ : na
stallNow = inImp and bar_index > impPeakBar and
     ((not na(zFade) and zFade <= stallFrac) or (not na(retr) and retr >= retraceFrac))
stallEvent = stallNow and not stalled
if stallEvent
    stalled := true
reversed = inImp and not na(retr) and retr >= 1.0     // ย้อนกลับจนพ้นจุดเริ่ม = กลับทิศจริง

// ─────────────────────────── ระยะห่างจาก zone OI ───────────────────────────
var array<float> zones = array.new<float>()
if barstate.isfirst
    for s in str.split(str.replace_all(str.replace_all(str.replace_all(zoneTxt, " ", ""), ";", ","), "\n", ","), ",")
        v = str.tonumber(s)
        if not na(v) and v > 0
            zones.push(v)

float zdist = na
float znear = na
if zones.size() > 0
    for zv in zones
        d = math.abs(close - zv)
        if na(zdist) or d < zdist
            zdist := d
            znear := zv
nearZone = zones.size() == 0 or (not na(zdist) and zdist <= zoneTol)

// ─────────────────────────── แถบ z ใต้กราฟ ───────────────────────────
// สีสด = กำลังฉีก (อย่าเพิ่งสวน) · สีจาง = หยุดฉีกแล้ว (ไม้แบบ A) · เทา = ไม่มีคลื่น
cWave = impDir > 0 ? cUp : cDn
barCol = not inImp ? color.new(color.gray, 70) : stalled ? color.new(cWave, 62) : color.new(cWave, 8)
plot(z, "z ของ DXY", style = plot.style_columns, color = barCol)
hline(0, "ศูนย์", color = color.new(color.gray, 40))
hline(zSpike, "เกณฑ์ฉีกขึ้น", color = color.new(color.gray, 70), linestyle = hline.style_dotted)
hline(-zSpike, "เกณฑ์ฉีกลง", color = color.new(color.gray, 70), linestyle = hline.style_dotted)
// จุดบนแท่งที่เป็นพีคของคลื่นปัจจุบัน — ไว้เห็นว่าผ่านพีคมากี่แท่งแล้ว
plotchar(inImp and bar_index == impPeakBar ? z : na, "พีคของคลื่น", "●", location.absolute,
     color.new(cWave, 0), size = size.tiny)

// ─────────────────────────── ทาบบนกราฟราคา ───────────────────────────
// พื้นหลังติดสีเฉพาะช่วงที่ "ยังฉีกอยู่" — สีหายเมื่อหยุดฉีก = ตาเห็นทันทีว่าช่วงไหนห้ามสวน
bgcolor(showBg and inImp and not stalled ? color.new(cWave, 90) : na, title = "ช่วงดอลลาร์กำลังฉีก",
     force_overlay = true)
// ▲▼ = แบบ B (เริ่มฉีกขณะราคาอยู่แถว zone) — ทิศของทองตรงข้ามกับ DXY
plotshape(showMarks and onset and nearZone and impDir > 0, "เริ่มฉีกขึ้น (ทองลง)",
     shape.triangledown, location.abovebar, color.new(cUp, 0), size = size.tiny, force_overlay = true)
plotshape(showMarks and onset and nearZone and impDir < 0, "เริ่มฉีกลง (ทองขึ้น)",
     shape.triangleup, location.belowbar, color.new(cDn, 0), size = size.tiny, force_overlay = true)
// ◆ = แบบ A (หยุดฉีกขณะราคาอยู่แถว zone)
plotshape(showMarks and stallEvent and nearZone, "หยุดฉีก", shape.diamond, location.belowbar,
     color.new(color.orange, 0), size = size.tiny, force_overlay = true)

// ─────────────────────────── ตารางสรุป ───────────────────────────
posOf(string p) =>
    switch p
        "ซ้ายบน"   => position.top_left
        "กลางบน"   => position.top_center
        "ขวาบน"    => position.top_right
        "ซ้ายล่าง"  => position.bottom_left
        "กลางล่าง" => position.bottom_center
        => position.bottom_right

stateTxt = not inImp ? "ไม่มีคลื่น" : reversed ? "กลับทิศ" : stalled ? "หยุดฉีก" :
     onset ? "เริ่มฉีก" : "กำลังฉีก"
stateCol = not inImp ? color.gray : reversed ? color.aqua : stalled ? color.orange : cWave
num(float v, string f) => na(v) ? "–" : str.tostring(v, f)

var table t = table.new(posOf(tblPos), 2, 5, bgcolor = color.new(color.black, 25),
     border_width = 1, border_color = color.new(color.gray, 70), frame_width = 1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "DXY " + str.tostring(nBars * timeframe.in_seconds(timeframe.period) / 60, "#") + "m",
         text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 0, stateTxt, text_color = stateCol, text_size = size.small)
    table.cell(t, 0, 1, "z", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 1, num(z, "0.0"), text_color = inImp ? cWave : color.silver, text_size = size.small)
    table.cell(t, 0, 2, "พีค / ผ่านมา", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 2, inImp ? num(impPeakZ, "0.0") + " / " + str.tostring(bar_index - impPeakBar, "#") + " แท่ง" : "–",
         text_color = color.silver, text_size = size.small)
    table.cell(t, 0, 3, "คลายแล้ว", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 3, inImp and not na(retr) ? num(retr * 100, "#") + "%" : "–",
         text_color = color.silver, text_size = size.small)
    table.cell(t, 0, 4, "zone ใกล้สุด", text_color = color.gray, text_size = size.small)
    table.cell(t, 1, 4, zones.size() == 0 ? "ไม่ได้ตั้ง" :
         num(znear, "#.#") + " (ห่าง " + num(zdist, "0.#") + ")",
         text_color = nearZone ? color.lime : color.gray, text_size = size.small)

// ─────────────────────────── alert ───────────────────────────
// ยิงตอนแท่งปิดตามค่าเริ่มต้น — ตั้งเป็น "ทุกครั้ง" ใน TradingView ได้ถ้าอยากได้เร็วกว่า
alertcondition(onset and nearZone and impDir > 0, "B · DXY เริ่มฉีกขึ้น ใกล้ zone",
     "ราคาอยู่แถว zone และดอลลาร์เริ่มฉีกขึ้น — ฝั่งทองเป็นขาลง")
alertcondition(onset and nearZone and impDir < 0, "B · DXY เริ่มฉีกลง ใกล้ zone",
     "ราคาอยู่แถว zone และดอลลาร์เริ่มฉีกลง — ฝั่งทองเป็นขาขึ้น")
alertcondition(stallEvent and nearZone, "A · DXY หยุดฉีก ใกล้ zone",
     "ดอลลาร์ฉีกแล้วเริ่มคลายขณะราคาอยู่แถว zone — จังหวะเด้งของไม้สวน")
alertcondition(onset, "DXY เริ่มฉีก (ไม่สนใจ zone)", "ดอลลาร์เริ่มฉีกเกินเกณฑ์ z")

//@version=6
// ============================================================================
//  DXY Pulse — จับ "การกระชาก" ของดอลลาร์ ณ ตอนกำลังจะเข้าไม้
//
//  ใช้คู่กับการเทรด Gold 0DTE แบบสวนที่ 2σ/3σ: ก่อนกดเข้าไม้ต้องรู้ว่าแรงที่ทำให้
//  ทองพุ่งมาจากดอลลาร์หรือจากฝั่งทองเอง เพราะถ้าดอลลาร์เป็นคนขับ แรงมักยังไม่หมด
//
//  วัดด้วย z ไม่ใช่ % ดิบ: % ตั้งแต่เปิดตลาดบอกไม่ได้ว่า "ตอนนี้กำลังพุ่งอยู่ไหม"
//      z = (ค่าตอนนี้ − ค่าเมื่อ N แท่งก่อน) ÷ ค่าเบี่ยงเบนปกติของการขยับ N แท่ง
//  z −2.4 = ดอลลาร์ร่วงแรงกว่าปกติ 2.4 เท่า · เทียบข้ามช่วงเวลาได้ (ตลาดเงียบ vs NFP)
//
//  ตั้งค่าเริ่มต้นสำหรับ TF 5 นาที: หน้าต่าง 3 แท่ง = 15 นาที
//  ดอลลาร์ใช้ TVC:DXY (ดัชนี) เพราะ ICEUS:DX1! ดีเลย์ในบัญชีที่ใช้อยู่
// ============================================================================
indicator("DXY Pulse", overlay = true)

G1 = "ข้อมูล"
dxySym   = input.symbol("TVC:DXY", "สัญลักษณ์ดอลลาร์", group = G1,
     tooltip = "ICEUS:DX1! เดินตาม tick เร็วกว่า แต่ถ้าบัญชีไม่มีสิทธิ์เรียลไทม์จะดีเลย์\n" +
               "TVC:DXY เป็นดัชนีคำนวณ ยูโรถ่วงน้ำหนักราว 58% ข่าวฝั่ง ECB จึงดันตัวนี้ได้โดยไม่เกี่ยวกับทอง")
nBars    = input.int(3, "หน้าต่างวัดการกระชาก (แท่ง)", minval = 1, group = G1,
     tooltip = "TF 5 นาที: 3 แท่ง = 15 นาที · 6 แท่ง = 30 นาที")
lookback = input.int(100, "ช่วงอ้างอิงความปกติ (แท่ง)", minval = 20, group = G1,
     tooltip = "ใช้หาค่าเบี่ยงเบนปกติของการขยับ · TF 5 นาที: 100 แท่ง ≈ 8 ชั่วโมง")
corrLen  = input.int(60, "ช่วงวัดความสัมพันธ์ (แท่ง)", minval = 10, group = G1)

G2 = "เกณฑ์"
zSpike   = input.float(2.0, "เกณฑ์กระชาก (z)", minval = 0.5, step = 0.1, group = G2)
holdBars = input.int(4, "ค้างสถานะหลังกระชาก (แท่ง)", minval = 0, group = G2,
     tooltip = "จังหวะกดเข้าไม้มักเป็นช่วงหลังกระชากไปแล้วนิดหน่อย ถ้าโชว์เฉพาะแท่งที่กระชากจะพลาด")

G3 = "การแสดงผล"
tblPos   = input.string("ขวาบน", "ตำแหน่งตาราง", group = G3,
     options = ["ซ้ายบน", "กลางบน", "ขวาบน", "ซ้ายล่าง", "กลางล่าง", "ขวาล่าง"])
txtSize  = input.string("เล็ก", "ขนาดตัวอักษร", options = ["จิ๋ว", "เล็ก", "ปกติ"], group = G3)
markBars = input.bool(true, "ทำเครื่องหมายบนแท่งที่ดอลลาร์กระชาก", group = G3)

// ─────────────────────────── ข้อมูล ───────────────────────────
dxy = request.security(dxySym, timeframe.period, close, ignore_invalid_symbol = true)

// z ของการขยับ N แท่ง เทียบกับความปกติของตัวมันเองในช่วง lookback
zOf(series float src, int n, int len) =>
    ch = src - src[n]
    sd = ta.stdev(ch, len)
    na(sd) or sd <= 0 ? float(na) : ch / sd

pctOf(series float src, int n) =>
    src[n] == 0 or na(src[n]) ? float(na) : (src - src[n]) / src[n] * 100

zD = zOf(dxy, nBars, lookback)
zG = zOf(close, nBars, lookback)
pD = pctOf(dxy, nBars)
pG = pctOf(close, nBars)
corr = ta.correlation(close, dxy, corrLen)

dSpike = not na(zD) and math.abs(zD) >= zSpike
gSpike = not na(zG) and math.abs(zG) >= zSpike
opposite = not na(zD) and not na(zG) and zD * zG < 0

// ค้างสถานะไว้อีก holdBars แท่งหลังกระชากครั้งล่าสุด
var int lastSpike = na
if dSpike or gSpike
    lastSpike := bar_index
active = not na(lastSpike) and bar_index - lastSpike <= holdBars

// ─────────────────────────── ตีความ ───────────────────────────
// สามสถานะที่ต้องแยกให้ออกก่อนเข้าไม้สวน
[stateTxt, stateCol] = switch
    gSpike and dSpike and opposite     => ["ขับด้วยดอลลาร์ · ระวังสวน", color.new(color.red, 0)]
    gSpike and dSpike and not opposite => ["ความสัมพันธ์หลุด · หลบ", color.new(color.orange, 0)]
    gSpike and not dSpike              => ["แรงจากฝั่งทองเอง", color.new(color.lime, 0)]
    dSpike and not gSpike              => ["ดอลลาร์กระชาก ทองยังไม่ตาม", color.new(color.yellow, 0)]
    active                             => ["เพิ่งกระชาก (ยังไม่คลาย)", color.new(color.silver, 0)]
    => ["ปกติ", color.new(color.gray, 0)]

// ─────────────────────────── ตาราง ───────────────────────────
posOf(string p) =>
    switch p
        "ซ้ายบน"   => position.top_left
        "กลางบน"   => position.top_center
        "ขวาบน"    => position.top_right
        "ซ้ายล่าง"  => position.bottom_left
        "กลางล่าง" => position.bottom_center
        => position.bottom_right

sz = txtSize == "จิ๋ว" ? size.tiny : txtSize == "เล็ก" ? size.small : size.normal
arrow(float z) => na(z) ? "" : z > 0 ? " ▲" : " ▼"
num(float v, string f) => na(v) ? "–" : str.tostring(v, f)

var table t = table.new(posOf(tblPos), 4, 4, bgcolor = color.new(color.black, 20),
     border_width = 1, border_color = color.new(color.gray, 60), frame_width = 1)

if barstate.islast
    mins = nBars * timeframe.in_seconds(timeframe.period) / 60
    table.cell(t, 0, 0, "DXY PULSE", text_color = color.silver, text_size = sz)
    table.cell(t, 1, 0, str.tostring(mins, "#") + "m", text_color = color.gray, text_size = sz)
    table.cell(t, 2, 0, "%", text_color = color.gray, text_size = sz)
    table.cell(t, 3, 0, "z", text_color = color.gray, text_size = sz)

    table.cell(t, 0, 1, "ดอลลาร์", text_color = color.silver, text_size = sz)
    table.cell(t, 1, 1, "", text_size = sz)
    table.cell(t, 2, 1, num(pD, "0.00") + "%", text_size = sz,
         text_color = na(pD) ? color.gray : pD > 0 ? color.red : color.lime)
    table.cell(t, 3, 1, num(zD, "0.0") + arrow(zD), text_size = sz,
         text_color = dSpike ? color.yellow : color.silver)

    table.cell(t, 0, 2, "ทอง", text_color = color.silver, text_size = sz)
    table.cell(t, 1, 2, "", text_size = sz)
    table.cell(t, 2, 2, num(pG, "0.00") + "%", text_size = sz,
         text_color = na(pG) ? color.gray : pG > 0 ? color.lime : color.red)
    table.cell(t, 3, 2, num(zG, "0.0") + arrow(zG), text_size = sz,
         text_color = gSpike ? color.yellow : color.silver)

    // แถวสรุป + ค่าความสัมพันธ์: ปกติทองกับดอลลาร์อยู่ราว -0.6 ถึง -0.8
    // ถ้าเข้าใกล้ 0 = ทองกำลังเคลื่อนด้วยเหตุผลของตัวเอง ตรรกะดอลลาร์ใช้ไม่ได้ชั่วคราว
    table.cell(t, 0, 3, stateTxt, text_color = stateCol, text_size = sz)
    table.cell(t, 1, 3, "", text_size = sz)
    table.cell(t, 2, 3, "corr", text_color = color.gray, text_size = sz)
    table.cell(t, 3, 3, num(corr, "0.00"), text_size = sz,
         text_color = na(corr) ? color.gray : math.abs(corr) < 0.3 ? color.orange : color.silver)

// จุดเล็กๆ ใต้/เหนือแท่งที่ดอลลาร์กระชาก (ไว้ดูย้อนหลังว่าจังหวะไหนเคยกระชาก)
plotchar(markBars and dSpike and zD > 0 ? 1 : na, "DXY พุ่ง", "▲", location.belowbar,
     color.new(color.red, 30), size = size.tiny)
plotchar(markBars and dSpike and zD < 0 ? 1 : na, "DXY ร่วง", "▼", location.abovebar,
     color.new(color.lime, 30), size = size.tiny)

// ─────────────────────────── alert ───────────────────────────
// ยิงตอนแท่งปิดตามค่าเริ่มต้นของ TradingView — ตั้งเป็น "ทุกครั้ง" ได้ถ้าอยากได้เร็วกว่า
alertcondition(dSpike, "DXY กระชาก", "ดอลลาร์กระชากเกินเกณฑ์ z")
alertcondition(gSpike and dSpike and opposite, "ทองพุ่งเพราะดอลลาร์",
     "ทองพุ่งพร้อมดอลลาร์สวนทางแรง — แรงมักยังไม่หมด ระวังสวน")
alertcondition(gSpike and not dSpike, "ทองพุ่งเอง ดอลลาร์นิ่ง",
     "ทองพุ่งโดยดอลลาร์ไม่ขยับ — โอกาสกลับเข้าหาค่ากลางดีกว่าปกติ")
